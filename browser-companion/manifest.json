{
  "manifest_version": 3,
  "name": "Axiom Studia Study Panel",
  "version": "1.0.0",
  "description": "Keep your Axiom timer, tasks, and subject resources beside a study website.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Open Axiom Studia study panel" }
}
